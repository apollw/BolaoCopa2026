@page
@model BolaoCopa2026.Pages.Palpites.IndexModel
@{
    ViewData["Title"] = "Palpites";
}

<section class="page-title">
    <p class="eyebrow">Area do participante</p>
    <h1>Meus Palpites</h1>
</section>

@if (TempData["Status"] is string status)
{
    <div class="notice">@status</div>
}

<section class="panel">
    <div class="panel-heading">
        <div>
            <h2>@Model.RoundView.Round.Name</h2>
            <span>@Model.RoundView.Round.StartsOn.ToString("dd/MM") a @Model.RoundView.Round.EndsOn.ToString("dd/MM")</span>
        </div>
        <div class="round-status @(Model.RoundView.IsFinalized ? "final" : "draft")">
            @(Model.RoundView.IsLocked ? "bloqueada" : Model.RoundView.IsFinalized ? "finalizada" : $"{Model.RoundView.DraftCount} rascunhos")
        </div>
    </div>

    <nav class="round-tabs" aria-label="Rodadas">
        @foreach (var round in Model.Rounds)
        {
            var isAvailable = Model.AvailableRoundIds.Contains(round.Id);
            <a class="@(round.Id == Model.RoundView.Round.Id ? "active" : null) @(!isAvailable ? "locked" : null)" asp-page="/Palpites/Index" asp-route-roundId="@round.Id">@round.Name</a>
        }
    </nav>

    @if (Model.RoundView.IsLocked)
    {
        <div class="notice">@Model.RoundView.LockReason</div>
    }

    <div class="match-list">
        @foreach (var item in Model.RoundView.Matches)
        {
            var match = item.Match;
            var prediction = item.Prediction;
            <article class="prediction-row">
                <div>
                    <strong>@match.OfficialNumber. @match.HomeTeam.Name x @match.AwayTeam.Name</strong>
                    <span>@(match.GroupName ?? match.Phase.ToString()) - @match.Kickoff.ToString("dd/MM/yyyy HH:mm") - @match.Venue</span>
                    @if (prediction is not null)
                    {
                        <small class="save-state">Salvo no perfil: @prediction.SavedAt.ToLocalTime().ToString("dd/MM HH:mm")</small>
                    }
                </div>
                <form method="post" asp-page-handler="SaveDraft" class="score-form">
                    <input type="hidden" name="roundId" value="@Model.RoundView.Round.Id" />
                    <input type="hidden" name="matchId" value="@match.Id" />
                    <input type="number" name="homeGoals" min="0" value="@(prediction?.HomeGoals ?? 0)" aria-label="Gols mandante" disabled="@(Model.RoundView.IsFinalized || Model.RoundView.IsLocked)" />
                    <span>x</span>
                    <input type="number" name="awayGoals" min="0" value="@(prediction?.AwayGoals ?? 0)" aria-label="Gols visitante" disabled="@(Model.RoundView.IsFinalized || Model.RoundView.IsLocked)" />
                    @if (match.IsKnockout)
                    {
                        <select name="qualifiedTeamCode" aria-label="Classificado" disabled="@(Model.RoundView.IsFinalized || Model.RoundView.IsLocked)">
                            <option value="">Classificado</option>
                            <option value="@match.HomeTeam.Code" selected="@(prediction?.QualifiedTeamCode == match.HomeTeam.Code)">@match.HomeTeam.Name</option>
                            <option value="@match.AwayTeam.Code" selected="@(prediction?.QualifiedTeamCode == match.AwayTeam.Code)">@match.AwayTeam.Name</option>
                        </select>
                    }
                    <button type="submit" class="btn-app" disabled="@(Model.RoundView.IsFinalized || Model.RoundView.IsLocked)">Salvar rascunho</button>
                </form>
            </article>
        }
    </div>
</section>

<section class="panel action-panel">
    <div>
        <h2>Fechamento da rodada</h2>
        <p>Enquanto a rodada nao for finalizada, os palpites ficam salvos como rascunho no perfil e o comprovante de auditoria permanece bloqueado.</p>
    </div>
    <div class="action-buttons">
        <form method="post" asp-page-handler="FinalizeRound">
            <input type="hidden" name="roundId" value="@Model.RoundView.Round.Id" />
            <button type="submit" class="btn-app danger" disabled="@(Model.RoundView.IsFinalized || Model.RoundView.IsLocked)">Finalizar rodada</button>
        </form>
        @if (Model.RoundView.CanSendAudit)
        {
            <a class="btn-app secondary link-button no-margin" asp-page-handler="DownloadAudit" asp-route-roundId="@Model.RoundView.Round.Id">Baixar comprovante</a>
        }
        else
        {
            <button type="button" class="btn-app secondary" disabled>Baixar comprovante</button>
        }
    </div>
</section>

<section class="panel muted-panel">
    <h2>Palpites especiais</h2>
    <p>Campeao, vice, artilheiro e Bola de Ouro ficam disponiveis aqui ate o inicio da Copa.</p>
</section>
