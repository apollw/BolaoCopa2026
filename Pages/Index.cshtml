@page
@model IndexModel
@{
    ViewData["Title"] = "Painel";
    var leader = Model.Stats.Ranking.FirstOrDefault();
}

<section class="page-hero">
    <div>
        <h1 class="eyebrow">Bolao Premier AEW</h1>
        <p class="hero-copy">Copa 2026 sob controle: palpites, ranking e auditoria em um so lugar.</p>
    </div>
    <div class="hero-panel">
        <span>Lider atual</span>
        <strong>@(leader?.Participant.Name ?? "Sem ranking")</strong>
        <small>@(leader?.Points ?? 0) pontos</small>
    </div>
</section>

<section class="stats-grid" aria-label="Resumo da Copa">
    <article>
        <span>Partidas registradas</span>
        <strong>@Model.Stats.CompletedCount/@Model.Stats.TotalMatches</strong>
    </article>
    <article>
        <span>Gols computados</span>
        <strong>@Model.Stats.GoalsScored</strong>
    </article>
    <article>
        <span>Jogos do Brasil finalizados</span>
        <strong>@Model.Stats.BrazilMatchesCompleted</strong>
    </article>
    <article>
        <span>Palpites especiais</span>
        <strong>@Model.Stats.SpecialPredictions.Count</strong>
    </article>
</section>

<section class="content-grid">
    <div class="panel">
        <div class="panel-heading">
            <h2>Ranking</h2>
            <span>desempate aplicado</span>
        </div>
        <div class="table-wrap">
            <table class="app-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Participante</th>
                        <th>Pontos</th>
                        <th>Exatos</th>
                        <th>Classif.</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var index = 0; index < Model.Stats.Ranking.Count; index++)
                    {
                        var entry = Model.Stats.Ranking[index];
                        <tr>
                            <td>@(index + 1)</td>
                            <td>@entry.Participant.Name</td>
                            <td><strong>@entry.Points</strong></td>
                            <td>@entry.ExactScores</td>
                            <td>@entry.KnockoutQualifiedHits</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="panel">
        <div class="panel-heading">
            <h2>Proximos Jogos</h2>
            <a asp-page="/Palpites/Index">ver palpites</a>
        </div>
        <div class="match-list">
            @foreach (var match in Model.Stats.UpcomingMatches)
            {
                <article class="match-row">
                    <div>
                        <strong>@match.HomeTeam.Name x @match.AwayTeam.Name</strong>
                        <span>@match.Phase - @match.Kickoff.ToString("dd/MM HH:mm")</span>
                    </div>
                    @if (match.IncludesBrazil)
                    {
                        <span class="pill">pontuacao dobrada</span>
                    }
                </article>
            }
        </div>
    </div>
</section>

<section class="panel">
    <div class="panel-heading">
        <h2>Classificacao dos Grupos</h2>
        <span>calculada pelos resultados reais registrados</span>
    </div>
    <div class="groups-grid">
        @foreach (var group in Model.Stats.GroupStandings)
        {
            <article class="group-table">
                <h3>@group.GroupName</h3>
                <div class="table-wrap">
                    <table class="app-table compact-table">
                        <thead>
                            <tr>
                                <th>Selecao</th>
                                <th>J</th>
                                <th>Pts</th>
                                <th>SG</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in group.Entries)
                            {
                                <tr>
                                    <td>@entry.Team.Name</td>
                                    <td>@entry.Played</td>
                                    <td><strong>@entry.Points</strong></td>
                                    <td>@entry.GoalDifference</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </article>
        }
    </div>
</section>

<section class="panel">
    <div class="panel-heading">
        <h2>Resultados Reais</h2>
        @if (User.IsInRole("Admin"))
        {
            <a asp-page="/Admin/Resultados">registrar resultado</a>
        }
    </div>
    <div class="match-list">
        @if (Model.Stats.CompletedMatches.Count == 0)
        {
            <article class="match-row">
                <div>
                    <strong>Nenhum resultado registrado ainda.</strong>
                    <span>Quando o admin registrar placares oficiais, eles aparecerao aqui.</span>
                </div>
            </article>
        }
        @foreach (var match in Model.Stats.CompletedMatches.Take(10))
        {
            <article class="match-row">
                <div>
                    <strong>@match.HomeTeam.Name @match.Result?.HomeGoals x @match.Result?.AwayGoals @match.AwayTeam.Name</strong>
                    <span>@(match.GroupName ?? match.Phase.ToString()) - jogo @match.OfficialNumber</span>
                </div>
            </article>
        }
    </div>
</section>

<section class="panel">
    <div class="panel-heading">
        <h2>Palpites Especiais</h2>
        <span>antes do inicio da Copa</span>
    </div>
    <div class="special-grid">
        @foreach (var prediction in Model.Stats.SpecialPredictions)
        {
            <article>
                <span>Participante @prediction.ParticipantId</span>
                <strong>@prediction.Champion</strong>
                <small>vice @prediction.RunnerUp | artilheiro @prediction.TopScorer | bola de ouro @prediction.GoldenBall</small>
            </article>
        }
    </div>
</section>
