@page
@model IndexModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Painel";
    var requestToken = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken ?? string.Empty;
    var leader = Model.Stats.Ranking.FirstOrDefault();
    var topPlayers = Model.Stats.Ranking.Take(3).ToList();
    var outcomeTotal = Model.Stats.PredictionOutcomeSlices.Sum(slice => slice.Value);
    var completedByRound = Model.Stats.Rounds
        .Select(round => new
        {
            Round = round,
            Matches = Model.Stats.CompletedMatches
                .Where(match => match.RoundId == round.Id)
                .OrderBy(match => match.Kickoff)
                .ThenBy(match => match.OfficialNumber)
                .ToList()
        })
        .Where(group => group.Matches.Count > 0)
        .ToList();
}

<section class="page-hero">
    <div>
        <h1 class="eyebrow">Bolao Premier AEW</h1>
        <p class="hero-copy">Copa 2026 sob controle: palpites, ranking e auditoria em um so lugar.</p>
    </div>
    <div class="hero-panel">
        <span>Lider atual</span>
        @if (leader is not null)
        {
            var leaderAvatar = Model.GetParticipantAvatar(leader.Participant);
            <strong class="ranking-name-with-avatar">
                <span class="participant-avatar avatar-sm">
                    @if (leaderAvatar.ImageUrl is not null)
                    {
                        <img src="@leaderAvatar.ImageUrl" alt="" loading="lazy" />
                    }
                    else
                    {
                        <span>@leaderAvatar.Symbol</span>
                    }
                </span>
                <span>@leader.Participant.Name</span>
            </strong>
        }
        else
        {
            <strong>Sem ranking</strong>
        }
        <small>@(leader?.Points ?? 0) pontos</small>
    </div>
</section>

<section class="stats-grid" aria-label="Resumo da Copa">
    <article>
        <span>Partidas registradas</span>
        <strong>@Model.Stats.CompletedCount/@Model.Stats.TotalMatches</strong>
    </article>
    <article>
        <span>Gols computados</span>
        <strong>@Model.Stats.GoalsScored</strong>
    </article>
    <article>
        <span>Jogos do Brasil finalizados</span>
        <strong>@Model.Stats.BrazilMatchesCompleted</strong>
    </article>
    <article>
        <span>Participantes</span>
        <strong>@Model.Stats.Ranking.Count</strong>
    </article>
</section>

<section class="panel dashboard-stats-panel">
    <div class="panel-heading">
        <div>
            <h2>Estatisticas gerais</h2>
            <span>visao consolidada da copa e dos jogadores</span>
        </div>
    </div>

    <div class="stats-grid dashboard-summary-grid">
        <article>
            <span>Total de pontos</span>
            <strong>@Model.Stats.TotalPoints</strong>
        </article>
        <article>
            <span>Palpites definitivos</span>
            <strong>@Model.Stats.FinalizedPredictions</strong>
        </article>
        <article>
            <span>Rascunhos abertos</span>
            <strong>@Model.Stats.DraftPredictions</strong>
        </article>
        <article>
            <span>Acertos exatos</span>
            <strong>@Model.Stats.ExactScores</strong>
        </article>
    </div>

    <div class="dashboard-charts-grid">
        <article class="panel chart-card">
            <div class="panel-heading">
                <div>
                    <h3>Distribuicao dos palpites definitivos</h3>
                    <span>@outcomeTotal palpites avaliados</span>
                </div>
            </div>
            <div class="chart-figure">
                <div class="chart-ring" style="@Model.BuildChartStyle(Model.Stats.PredictionOutcomeSlices)">
                    <span class="chart-ring-label">
                        @outcomeTotal
                        <small>avaliados</small>
                    </span>
                </div>
                <div class="chart-legend">
                    @foreach (var slice in Model.Stats.PredictionOutcomeSlices)
                    {
                        var percent = outcomeTotal > 0 ? Math.Round(slice.Value * 100d / outcomeTotal) : 0;
                        <div class="chart-legend-item">
                            <span class="chart-legend-swatch" style="background:@slice.Color"></span>
                            <span class="chart-legend-label">@slice.Label</span>
                            <span class="chart-legend-value">@slice.Value (@percent%)</span>
                        </div>
                    }
                </div>
            </div>
        </article>

        <article class="panel chart-card highlight-card">
            <div class="panel-heading">
                <div>
                    <h3>Destaques dos palpites</h3>
                    <span>padroes que mais apareceram no bolao</span>
                </div>
            </div>
            <div class="highlight-list">
                @foreach (var item in Model.Stats.HighlightCards)
                {
                    <article class="highlight-item">
                        <span class="highlight-title">@item.Title</span>
                        <strong>@item.Value</strong>
                        <small>@item.Caption</small>
                    </article>
                }
            </div>
        </article>
    </div>

    <div class="dashboard-players-grid">
        @for (var index = 0; index < topPlayers.Count; index++)
        {
            var entry = topPlayers[index];
            var avatar = Model.GetParticipantAvatar(entry.Participant);
            var playerClass = entry == leader ? "top-player gold" : "top-player";
            <article class="@playerClass">
                <span class="top-player-rank">#@(index + 1)</span>
                <strong class="ranking-name-with-avatar">
                    <span class="participant-avatar avatar-sm">
                        @if (avatar.ImageUrl is not null)
                        {
                            <img src="@avatar.ImageUrl" alt="" loading="lazy" />
                        }
                        else
                        {
                            <span>@avatar.Symbol</span>
                        }
                    </span>
                    <span>@entry.Participant.Name</span>
                </strong>
                <small>@entry.Points pontos</small>
                <span>@entry.ExactScores exatos - @entry.KnockoutQualifiedHits classif. - @entry.BrazilHits brasil</span>
            </article>
        }
    </div>
</section>

<section class="panel message-board-panel">
    <div class="panel-heading">
        <div>
            <h2>Mural de Mensagens</h2>
            <span data-message-board-count>@Model.MessageBoard.TotalMessages mensagem(ns) - 5 por pagina</span>
        </div>
        <button type="button"
                class="section-toggle"
                data-collapse-target="message-board-body"
                aria-controls="message-board-body"
                aria-expanded="true"
                aria-label="Recolher mural de mensagens">−</button>
    </div>

    <div id="message-board-body" class="collapsible-body">
        @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin"))
        {
            <form method="post"
                  asp-page-handler="AddMessage"
                  class="message-board-form"
                  data-skip-global-loading="true"
                  data-message-board-form>
                <input type="hidden" name="messagesPage" value="@Model.MessageBoard.Page" />
                <label class="message-board-field">
                    <span>Nova mensagem</span>
                    <textarea asp-for="MessageInput.Message" maxlength="200" rows="3" placeholder="Escreva algo sobre a Copa..."></textarea>
                    <small>Limite de 200 caracteres.</small>
                </label>
                <div class="message-board-actions">
                    <label class="message-board-field compact">
                        <span>Humor opcional</span>
                        <select asp-for="MessageInput.MoodKey">
                            <option value="">Sem humor</option>
                            @foreach (var mood in MessageMoodCatalog.All)
                            {
                                <option value="@mood.Key">@mood.Emoji @mood.Label</option>
                            }
                        </select>
                    </label>
                    <button type="submit" class="btn-app">Publicar</button>
                </div>
            </form>
        }
        else
        {
            <div class="notice">Entre como participante para publicar mensagens no mural.</div>
        }

        <div class="message-board-list" data-message-board-list>
            @if (Model.MessageBoard.Messages.Count == 0)
            {
                <div class="message-board-empty">Nenhuma mensagem publicada ainda.</div>
            }
            else
            {
                @foreach (var message in Model.MessageBoard.Messages)
                {
                    var avatar = Model.GetParticipantAvatar(message.Author.AvatarKey, message.Author.AvatarImagePath);
                <article class="message-card">
                        <div class="message-card-header">
                            <div class="message-author">
                                <span class="participant-avatar avatar-sm">
                                    @if (avatar.ImageUrl is not null)
                                    {
                                        <img src="@avatar.ImageUrl" alt="" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span>@avatar.Symbol</span>
                                    }
                                </span>
                                <div>
                                    <strong>@message.Author.Name</strong>
                                    <small>@message.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(message.MoodLabel))
                            {
                                <span class="message-mood">@message.MoodEmoji @message.MoodLabel</span>
                            }
                        </div>
                        <p>@message.Body</p>
                        @if (message.CanDelete)
                        {
                            <div class="message-card-actions">
                                <form method="post"
                                      asp-page-handler="DeleteMessage"
                                      class="message-delete-form"
                                      data-message-delete-form
                                      data-skip-global-loading="true">
                                    <input type="hidden" name="messageId" value="@message.Id" />
                                    <input type="hidden" name="messagesPage" value="@Model.MessageBoard.Page" />
                                    <button type="submit" class="btn-app danger message-delete-button">Excluir</button>
                                </form>
                            </div>
                        }
                    </article>
                }
            }
        </div>

        <div class="message-board-pagination"
             data-message-board-pagination
             data-current-page="@Model.MessageBoard.Page"
             data-total-pages="@Model.MessageBoard.TotalPages"
             @(Model.MessageBoard.TotalPages <= 1 ? "hidden" : null)>
            <a class="btn-app secondary @(Model.MessageBoard.HasPreviousPage ? null : "disabled")"
               asp-page="/Index"
               asp-route-messagesPage="@(Math.Max(Model.MessageBoard.Page - 1, 1))">
                Anterior
            </a>
            <span>Página @Model.MessageBoard.Page de @Model.MessageBoard.TotalPages</span>
            <a class="btn-app secondary @(Model.MessageBoard.HasNextPage ? null : "disabled")"
               asp-page="/Index"
               asp-route-messagesPage="@(Math.Min(Model.MessageBoard.Page + 1, Model.MessageBoard.TotalPages))">
                Próxima
            </a>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const form = document.querySelector('[data-message-board-form]');
            const list = document.querySelector('[data-message-board-list]');
            const count = document.querySelector('[data-message-board-count]');
            const pagination = document.querySelector('[data-message-board-pagination]');
            const requestToken = '@requestToken';

            if (!list || !count) {
                return;
            }

            const escapeHtml = value => String(value ?? '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#39;');

            const formatDate = value => new Intl.DateTimeFormat('pt-BR', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            }).format(new Date(value));

            const avatarMarkup = (avatarKey, avatarImagePath) => {
                if (avatarImagePath) {
                    return `<img src="${escapeHtml(avatarImagePath)}" alt="" loading="lazy" />`;
                }

                const key = String(avatarKey ?? 'none').toLowerCase();
                const avatarMap = {
                    'flag-bra': { kind: 'team', src: 'https://flagcdn.com/w80/br.png' },
                    'emoji-ball': { kind: 'emoji', symbol: '⚽' },
                    'emoji-trophy': { kind: 'emoji', symbol: '🏆' },
                    'emoji-whistle': { kind: 'emoji', symbol: '🪈' },
                    'emoji-goal': { kind: 'emoji', symbol: '🥅' },
                    'emoji-fire': { kind: 'emoji', symbol: '🔥' },
                    'emoji-clap': { kind: 'emoji', symbol: '👏' },
                    'emoji-shield': { kind: 'emoji', symbol: '🛡' },
                    'emoji-star': { kind: 'emoji', symbol: '⭐' }
                };

                const avatar = avatarMap[key];
                if (avatar?.kind === 'team') {
                    return `<img src="${avatar.src}" alt="" loading="lazy" />`;
                }

                return `<span>${escapeHtml(avatar?.symbol ?? '👤')}</span>`;
            };

            const renderMood = entry => {
                if (!entry.moodLabel) {
                    return '';
                }

                return `<span class="message-mood">${escapeHtml(entry.moodEmoji ?? '')} ${escapeHtml(entry.moodLabel)}</span>`;
            };

            const renderCard = entry => `
                        <article class="message-card">
                    <div class="message-card-header">
                        <div class="message-author">
                            <span class="participant-avatar avatar-sm">${avatarMarkup(entry.author.avatarKey, entry.author.avatarImagePath)}</span>
                            <div>
                                <strong>${escapeHtml(entry.author.name)}</strong>
                                <small>${formatDate(entry.createdAt)}</small>
                            </div>
                        </div>
                        ${renderMood(entry)}
                    </div>
                    <p>${escapeHtml(entry.body)}</p>
                    ${entry.canDelete ? `
                        <div class="message-card-actions">
                            <form method="post" action="?handler=DeleteMessage" class="message-delete-form" data-skip-global-loading="true" data-message-delete-form>
                                <input type="hidden" name="__RequestVerificationToken" value="${escapeHtml(requestToken)}" />
                                <input type="hidden" name="messageId" value="${entry.id}" />
                                <input type="hidden" name="messagesPage" value="${pagination?.dataset.currentPage ?? '1'}" />
                                <button type="submit" class="btn-app danger message-delete-button">Excluir</button>
                            </form>
                        </div>
                    ` : ''}
                </article>
            `;

            const updateCount = totalMessages => {
                count.textContent = `${totalMessages} mensagem(ns) - 5 por pagina`;
            };

            const updatePagination = board => {
                if (!pagination) {
                    return;
                }

                const page = Number(board.page || 1);
                const totalPages = Number(board.totalPages || 1);

                pagination.dataset.currentPage = page;
                pagination.dataset.totalPages = totalPages;
                pagination.hidden = totalPages <= 1;
                pagination.innerHTML = `
                    <a class="btn-app secondary ${page > 1 ? '' : 'disabled'}" href="?messagesPage=${Math.max(page - 1, 1)}">Anterior</a>
                    <span>Página ${page} de ${totalPages}</span>
                    <a class="btn-app secondary ${page < totalPages ? '' : 'disabled'}" href="?messagesPage=${Math.min(page + 1, totalPages)}">Próxima</a>
                `;
            };

            const buildBoardUrl = page => `?handler=MessageBoard&messagesPage=${Math.max(Number(page || 1), 1)}`;

            const loadBoard = async (page, options = {}) => {
                const targetPage = Math.max(Number(page || 1), 1);
                const response = await fetch(buildBoardUrl(targetPage), {
                    credentials: 'same-origin',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                const data = await readJsonResponse(response);
                if (!response.ok || !data.success) {
                    throw new Error(data.message || 'Nao foi possivel carregar o mural.');
                }

                updateCount(data.board.totalMessages);
                updatePagination(data.board);
                renderBoardMessages(data.board.messages ?? []);

                if (options.pushState !== false) {
                    const url = new URL(window.location.href);
                    url.searchParams.set('messagesPage', String(data.board.page || targetPage));
                    window.history.replaceState({}, '', url);
                }

                return data.board;
            };

            const clearEmptyState = () => {
                const empty = list.querySelector('.message-board-empty');
                if (empty) {
                    empty.remove();
                }
            };

            const readJsonResponse = async response => {
                const text = await response.text();
                if (!text.trim()) {
                    throw new Error('A resposta do servidor veio vazia.');
                }

                try {
                    return JSON.parse(text);
                } catch {
                    throw new Error('A resposta do servidor nao veio em formato esperado.');
                }
            };

            const renderBoardMessages = messages => {
                list.innerHTML = messages.map(renderCard).join('');
                if (!messages.length) {
                    list.innerHTML = '<div class="message-board-empty">Nenhuma mensagem publicada ainda.</div>';
                }
            };

            document.addEventListener('submit', async event => {
                const formTarget = event.target;
                if (!(formTarget instanceof HTMLFormElement) || !formTarget.matches('[data-message-delete-form]')) {
                    return;
                }

                const deleteForm = formTarget;

                event.preventDefault();

                if (!window.confirm('Excluir esta mensagem?')) {
                    return;
                }

                const submitButton = deleteForm.querySelector('button[type="submit"]');
                const payload = new FormData(deleteForm);

                submitButton?.setAttribute('disabled', 'true');
                window.appLoading?.show?.('Excluindo mensagem...');

                try {
                    const response = await fetch(deleteForm.action, {
                        method: 'POST',
                        body: payload,
                        credentials: 'same-origin',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    if (!response.ok) {
                        const data = await readJsonResponse(response).catch(() => null);
                        throw new Error(data?.message || 'Nao foi possivel excluir a mensagem.');
                    }

                    const currentPage = pagination?.dataset.currentPage ?? deleteForm.querySelector('input[name="messagesPage"]')?.value ?? '1';
                    await loadBoard(currentPage, { pushState: false });
                } catch (error) {
                    window.alert(error?.message || 'Nao foi possivel excluir a mensagem.');
                } finally {
                    submitButton?.removeAttribute('disabled');
                    window.appLoading?.hide?.();
                }
            });

            if (form) {
                form.addEventListener('submit', async event => {
                    event.preventDefault();

                    const submitButton = form.querySelector('button[type="submit"]');
                    const payload = new FormData(form);

                    submitButton?.setAttribute('disabled', 'true');
                    window.appLoading?.show?.('Publicando mensagem...');

                    try {
                        const response = await fetch(form.action, {
                            method: 'POST',
                            body: payload,
                            credentials: 'same-origin',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        const data = await readJsonResponse(response);
                        if (!response.ok || !data.success) {
                            throw new Error(data.message || 'Nao foi possivel publicar a mensagem.');
                        }

                        await loadBoard(1, { pushState: true });

                        form.reset();
                        form.querySelector('textarea')?.focus();
                    } catch (error) {
                        window.alert(error?.message || 'Nao foi possivel publicar a mensagem.');
                    } finally {
                        submitButton?.removeAttribute('disabled');
                        window.appLoading?.hide?.();
                    }
                });
            }

            document.addEventListener('click', async event => {
                const link = event.target instanceof Element ? event.target.closest('[data-message-board-pagination] a[href*="messagesPage="]') : null;
                if (!link || !(link instanceof HTMLAnchorElement) || link.classList.contains('disabled')) {
                    return;
                }

                event.preventDefault();

                try {
                    const targetUrl = new URL(link.href, window.location.origin);
                    const targetPage = targetUrl.searchParams.get('messagesPage') || '1';
                    window.appLoading?.show?.('Carregando mensagens...');
                    await loadBoard(targetPage, { pushState: true });
                } catch (error) {
                    window.alert(error?.message || 'Nao foi possivel carregar o mural.');
                } finally {
                    window.appLoading?.hide?.();
                }
            });
        })();
    </script>
}

<section class="content-grid">
    <div class="panel">
        <div class="panel-heading">
            <div>
                <h2>Ranking</h2>
                <span>desempate aplicado</span>
            </div>
        </div>
        <div class="table-wrap">
            <table class="app-table app-table-stack">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Participante</th>
                        <th>Pontos</th>
                        <th>Exatos</th>
                        <th>Classif.</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var index = 0; index < Model.Stats.Ranking.Count; index++)
                    {
                        var entry = Model.Stats.Ranking[index];
                        var avatar = Model.GetParticipantAvatar(entry.Participant);
                        var placeClass = index switch
                        {
                            0 => "first-place",
                            1 => "second-place",
                            2 => "third-place",
                            _ => "default-place"
                        };
                        <tr>
                            <td data-label="Posicao">
                                <span class="ranking-position @placeClass">#@(index + 1)</span>
                            </td>
                            <td data-label="Participante">
                                <span class="ranking-name ranking-name-with-avatar">
                                    <span class="participant-avatar avatar-xs">
                                        @if (avatar.ImageUrl is not null)
                                        {
                                            <img src="@avatar.ImageUrl" alt="" loading="lazy" />
                                        }
                                        else
                                        {
                                            <span>@avatar.Symbol</span>
                                        }
                                    </span>
                                    <span>@entry.Participant.Name</span>
                                </span>
                            </td>
                            <td data-label="Pontos">
                                <strong class="ranking-points">@entry.Points</strong>
                            </td>
                            <td data-label="Exatos">@entry.ExactScores</td>
                            <td data-label="Classif.">@entry.KnockoutQualifiedHits</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="panel">
        <div class="panel-heading">
            <div>
                <h2>Proximos Jogos</h2>
                <span>@Model.Stats.UpcomingMatches.Count partidas</span>
            </div>
            <a asp-page="/Palpites/Index">ver palpites</a>
        </div>
        @foreach (var match in Model.Stats.UpcomingMatches)
        {
            var homeFlag = TeamDisplay.GetFlagUrl(match.HomeTeam);
            var awayFlag = TeamDisplay.GetFlagUrl(match.AwayTeam);
            <article class="match-row">
                <div>
                    <strong class="team-line">
                        <span class="team-label">
                            @if (homeFlag is not null)
                            {
                                <img class="team-flag" src="@homeFlag" alt="" loading="lazy" />
                            }
                            <span>@TeamDisplay.GetName(match.HomeTeam)</span>
                        </span>
                        <span class="team-vs">x</span>
                        <span class="team-label">
                            @if (awayFlag is not null)
                            {
                                <img class="team-flag" src="@awayFlag" alt="" loading="lazy" />
                            }
                            <span>@TeamDisplay.GetName(match.AwayTeam)</span>
                        </span>
                    </strong>
                    <span>@match.Phase - @match.Kickoff.ToString("dd/MM HH:mm")</span>
                </div>
                @if (match.IncludesBrazil)
                {
                    <span class="pill">pontuacao dobrada</span>
                }
            </article>
        }
    </div>
</section>

<section class="panel">
    <div class="panel-heading">
        <div>
            <h2>Classificacao dos Grupos</h2>
            <span>calculada pelos resultados reais registrados</span>
        </div>
        <button type="button"
                class="section-toggle"
                data-collapse-target="groups-body"
                aria-controls="groups-body"
                aria-expanded="true"
                aria-label="Recolher classificacao dos grupos">−</button>
    </div>
    <div id="groups-body" class="collapsible-body">
        <div class="groups-grid">
            @foreach (var group in Model.Stats.GroupStandings)
            {
                <article class="group-table">
                    <h3>@group.GroupName</h3>
                    <div class="table-wrap">
                        <table class="app-table app-table-stack compact-table">
                            <thead>
                                <tr>
                                    <th>Selecao</th>
                                    <th>J</th>
                                    <th>Pts</th>
                                    <th>SG</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in group.Entries)
                                {
                                    var teamFlag = TeamDisplay.GetFlagUrl(entry.Team);
                                    <tr>
                                        <td data-label="Selecao">
                                            <span class="team-label">
                                                @if (teamFlag is not null)
                                                {
                                                    <img class="team-flag" src="@teamFlag" alt="" loading="lazy" />
                                                }
                                                <span>@TeamDisplay.GetName(entry.Team)</span>
                                            </span>
                                        </td>
                                        <td data-label="Jogos">@entry.Played</td>
                                        <td data-label="Pontos"><strong>@entry.Points</strong></td>
                                        <td data-label="Saldo">@entry.GoalDifference</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="panel">
    <div class="panel-heading">
        <div>
            <h2>Resultados Reais</h2>
            <span>@Model.Stats.CompletedMatches.Count resultados registrados</span>
        </div>
        <button type="button"
                class="section-toggle"
                data-collapse-target="results-body"
                aria-controls="results-body"
                aria-expanded="true"
                aria-label="Recolher resultados reais">−</button>
    </div>
    <div id="results-body" class="collapsible-body">
        @foreach (var roundGroup in completedByRound)
        {
            <details class="round-results-group">
                <summary class="round-results-summary">
                    <strong>@roundGroup.Round.Name</strong>
                    <span>@roundGroup.Matches.Count jogo(s)</span>
                </summary>
                <div class="match-list">
                    @foreach (var match in roundGroup.Matches)
                    {
                        var homeFlag = TeamDisplay.GetFlagUrl(match.HomeTeam);
                        var awayFlag = TeamDisplay.GetFlagUrl(match.AwayTeam);
                        <article class="match-row">
                            <div>
                                <strong class="team-line">
                                    <span class="team-label">
                                        @if (homeFlag is not null)
                                        {
                                            <img class="team-flag" src="@homeFlag" alt="" loading="lazy" />
                                        }
                                        <span>@TeamDisplay.GetName(match.HomeTeam)</span>
                                    </span>
                                    <span>@match.Result?.HomeGoals x @match.Result?.AwayGoals</span>
                                    <span class="team-label">
                                        @if (awayFlag is not null)
                                        {
                                            <img class="team-flag" src="@awayFlag" alt="" loading="lazy" />
                                        }
                                        <span>@TeamDisplay.GetName(match.AwayTeam)</span>
                                    </span>
                                </strong>
                                <span>@(match.GroupName ?? match.Phase.ToString()) - jogo @match.OfficialNumber</span>
                            </div>
                        </article>
                    }
                </div>
            </details>
        }
    </div>
</section>
