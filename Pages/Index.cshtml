@page
@model IndexModel
@{
    ViewData["Title"] = "Painel";
    var leader = Model.Stats.Ranking.FirstOrDefault();
}

<section class="page-hero">
    <div>
        <h1 class="eyebrow">Bolao Premier AEW</h1>
        <p class="hero-copy">Copa 2026 sob controle: palpites, ranking e auditoria em um so lugar.</p>
    </div>
    <div class="hero-panel">
        <span>Lider atual</span>
        <strong>@(leader?.Participant.Name ?? "Sem ranking")</strong>
        <small>@(leader?.Points ?? 0) pontos</small>
    </div>
</section>

<section class="stats-grid" aria-label="Resumo da Copa">
    <article>
        <span>Partidas registradas</span>
        <strong>@Model.Stats.CompletedCount/@Model.Stats.TotalMatches</strong>
    </article>
    <article>
        <span>Gols computados</span>
        <strong>@Model.Stats.GoalsScored</strong>
    </article>
    <article>
        <span>Jogos do Brasil finalizados</span>
        <strong>@Model.Stats.BrazilMatchesCompleted</strong>
    </article>
    <article>
        <span>Participantes</span>
        <strong>@Model.Stats.Ranking.Count</strong>
    </article>
</section>

<section class="content-grid">
    <div class="panel">
        <div class="panel-heading">
            <h2>Ranking</h2>
            <span>desempate aplicado</span>
        </div>
        <div class="table-wrap">
            <table class="app-table app-table-stack">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Participante</th>
                        <th>Pontos</th>
                        <th>Exatos</th>
                        <th>Classif.</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var index = 0; index < Model.Stats.Ranking.Count; index++)
                    {
                        var entry = Model.Stats.Ranking[index];
                        var placeClass = index switch
                        {
                            0 => "first-place",
                            1 => "second-place",
                            2 => "third-place",
                            _ => "default-place"
                        };
                        <tr>
                            <td data-label="Posicao">
                                <span class="ranking-position @placeClass">#@(index + 1)</span>
                            </td>
                            <td data-label="Participante">
                                <span class="ranking-name">@entry.Participant.Name</span>
                            </td>
                            <td data-label="Pontos">
                                <strong class="ranking-points">@entry.Points</strong>
                            </td>
                            <td data-label="Exatos">@entry.ExactScores</td>
                            <td data-label="Classif.">@entry.KnockoutQualifiedHits</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="panel">
        <div class="panel-heading">
            <h2>Proximos Jogos</h2>
            <a asp-page="/Palpites/Index">ver palpites</a>
        </div>
        <div class="match-list">
            @foreach (var match in Model.Stats.UpcomingMatches)
            {
                var homeFlag = TeamDisplay.GetFlagUrl(match.HomeTeam);
                var awayFlag = TeamDisplay.GetFlagUrl(match.AwayTeam);
                <article class="match-row">
                    <div>
                        <strong class="team-line">
                            <span class="team-label">
                                @if (homeFlag is not null)
                                {
                                    <img class="team-flag" src="@homeFlag" alt="" loading="lazy" />
                                }
                                <span>@TeamDisplay.GetName(match.HomeTeam)</span>
                            </span>
                            <span class="team-vs">x</span>
                            <span class="team-label">
                                @if (awayFlag is not null)
                                {
                                    <img class="team-flag" src="@awayFlag" alt="" loading="lazy" />
                                }
                                <span>@TeamDisplay.GetName(match.AwayTeam)</span>
                            </span>
                        </strong>
                        <span>@match.Phase - @match.Kickoff.ToString("dd/MM HH:mm")</span>
                    </div>
                    @if (match.IncludesBrazil)
                    {
                        <span class="pill">pontuacao dobrada</span>
                    }
                </article>
            }
        </div>
    </div>
</section>

<section class="panel muted-panel">
    <div class="panel-heading">
        <h2>Mural de Palpites</h2>
        <a asp-page="/Mural">abrir mural completo</a>
    </div>
    <p>Consulte os palpites definitivos de todos os participantes, inclusive os especiais, em uma tela dedicada por participante e por rodada.</p>
</section>

<section class="panel">
    <div class="panel-heading">
        <h2>Classificacao dos Grupos</h2>
        <span>calculada pelos resultados reais registrados</span>
    </div>
    <div class="groups-grid">
        @foreach (var group in Model.Stats.GroupStandings)
        {
            <article class="group-table">
                <h3>@group.GroupName</h3>
                <div class="table-wrap">
                    <table class="app-table app-table-stack compact-table">
                        <thead>
                            <tr>
                                <th>Selecao</th>
                                <th>J</th>
                                <th>Pts</th>
                                <th>SG</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in group.Entries)
                            {
                                var teamFlag = TeamDisplay.GetFlagUrl(entry.Team);
                                <tr>
                                    <td data-label="Selecao">
                                        <span class="team-label">
                                            @if (teamFlag is not null)
                                            {
                                                <img class="team-flag" src="@teamFlag" alt="" loading="lazy" />
                                            }
                                            <span>@TeamDisplay.GetName(entry.Team)</span>
                                        </span>
                                    </td>
                                    <td data-label="Jogos">@entry.Played</td>
                                    <td data-label="Pontos"><strong>@entry.Points</strong></td>
                                    <td data-label="Saldo">@entry.GoalDifference</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </article>
        }
    </div>
</section>

<section class="panel">
    <div class="panel-heading">
        <h2>Resultados Reais</h2>
        @if (User.IsInRole("Admin"))
        {
            <a asp-page="/Admin/Resultados">registrar resultado</a>
        }
    </div>
    <div class="match-list">
        @if (Model.Stats.CompletedMatches.Count == 0)
        {
            <article class="match-row">
                <div>
                    <strong>Nenhum resultado registrado ainda.</strong>
                    <span>Quando o admin registrar placares oficiais, eles aparecerao aqui.</span>
                </div>
            </article>
        }
        @foreach (var match in Model.Stats.CompletedMatches.Take(10))
        {
            var homeFlag = TeamDisplay.GetFlagUrl(match.HomeTeam);
            var awayFlag = TeamDisplay.GetFlagUrl(match.AwayTeam);
            <article class="match-row">
                <div>
                    <strong class="team-line">
                        <span class="team-label">
                            @if (homeFlag is not null)
                            {
                                <img class="team-flag" src="@homeFlag" alt="" loading="lazy" />
                            }
                            <span>@TeamDisplay.GetName(match.HomeTeam)</span>
                        </span>
                        <span>@match.Result?.HomeGoals x @match.Result?.AwayGoals</span>
                        <span class="team-label">
                            @if (awayFlag is not null)
                            {
                                <img class="team-flag" src="@awayFlag" alt="" loading="lazy" />
                            }
                            <span>@TeamDisplay.GetName(match.AwayTeam)</span>
                        </span>
                    </strong>
                    <span>@(match.GroupName ?? match.Phase.ToString()) - jogo @match.OfficialNumber</span>
                </div>
            </article>
        }
    </div>
</section>

