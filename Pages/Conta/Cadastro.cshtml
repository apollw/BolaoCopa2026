@page
@model BolaoCopa2026.Pages.Conta.CadastroModel
@{
    ViewData["Title"] = "Cadastro";
}

<section class="page-title">
    <p class="eyebrow">Conta</p>
    <h1>Criar Cadastro</h1>
</section>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="notice">@Model.StatusMessage</div>
}

<section class="profile-layout">
    <article class="panel">
        <h2>Entrar no bolao</h2>
        <form method="post" class="stacked-form">
            <label asp-for="Input.Name">
                Nome
                <input asp-for="Input.Name" autocomplete="name" />
                <span asp-validation-for="Input.Name"></span>
            </label>
            <label asp-for="Input.Email">
                Email
                <input asp-for="Input.Email" autocomplete="email" />
                <span asp-validation-for="Input.Email"></span>
            </label>
            <label asp-for="Input.Password">
                Senha
                <input asp-for="Input.Password" autocomplete="new-password" />
                <span asp-validation-for="Input.Password"></span>
            </label>
            <label asp-for="Input.ConfirmPassword">
                Confirmar senha
                <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword"></span>
            </label>
            <button class="btn-app" type="submit">Criar cadastro</button>
        </form>
    </article>

    <article class="panel muted-panel">
        <h2>Email de auditoria</h2>
        <p>O mesmo email cadastrado aqui sera usado para receber os comprovantes e auditorias de palpites finalizados.</p>
    </article>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
