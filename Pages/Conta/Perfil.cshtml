@page
@model BolaoCopa2026.Pages.Conta.PerfilModel
@{
    ViewData["Title"] = "Perfil";
}

<section class="page-title">
    <p class="eyebrow">Conta</p>
    <h1>Perfil do Participante</h1>
</section>

@if (TempData["Status"] is string status)
{
    <div class="notice">@status</div>
}

<section class="profile-layout">
    <article class="panel profile-card">
        <div class="profile-hero">
            <div class="profile-avatar-preview">
                @if (Model.CurrentAvatar is null || Model.CurrentAvatar.Key == "none")
                {
                    <span>👤</span>
                }
                else if (Model.CurrentAvatar.ImageUrl is not null)
                {
                    <img src="@Model.CurrentAvatar.ImageUrl" alt="" loading="lazy" />
                }
                else
                {
                    <span>@Model.CurrentAvatar.Symbol</span>
                }
            </div>
            <div>
                <h2>@Model.Participant?.Name</h2>
                <p>@(Model.CurrentAvatar?.Label ?? "Sem avatar selecionado")</p>
            </div>
        </div>

        <form class="stacked-form">
            <label>
                Nome
                <input type="text" value="@Model.Participant?.Name" readonly />
            </label>
            <label>
                Email
                <input type="email" value="@Model.Participant?.Email" readonly />
            </label>
            <label>
                Login
                <input type="text" value="@Model.Participant?.Login" readonly />
            </label>
        </form>
    </article>

    <article class="panel">
        <div class="panel-heading">
            <h2>Escolher avatar</h2>
            <span>defina a identidade visiva do seu perfil</span>
        </div>

        <form method="post" class="stacked-form avatar-picker-form">
            <div class="avatar-picker-grid" role="radiogroup" aria-label="Escolha de avatar">
                @foreach (var avatar in Model.AvatarOptions)
                {
                    var isSelected = string.Equals(Model.SelectedAvatarKey, avatar.Key, StringComparison.OrdinalIgnoreCase);
                    <label class="avatar-option @(isSelected ? "active" : null)">
                        <input type="radio"
                               name="SelectedAvatarKey"
                               value="@avatar.Key"
                               checked="@isSelected"
                               data-avatar-choice />
                        <span class="avatar-option-visual">
                            @if (avatar.ImageUrl is not null)
                            {
                                <img src="@avatar.ImageUrl" alt="" loading="lazy" />
                            }
                            else
                            {
                                <span class="avatar-emoji">@avatar.Symbol</span>
                            }
                        </span>
                        <span class="avatar-option-label">@avatar.Label</span>
                    </label>
                }
            </div>

            <div class="profile-avatar-summary">
                <div class="profile-avatar-preview small" data-avatar-preview>
                    @if (Model.CurrentAvatar is null || Model.CurrentAvatar.Key == "none")
                    {
                        <span>👤</span>
                    }
                    else if (Model.CurrentAvatar.ImageUrl is not null)
                    {
                        <img src="@Model.CurrentAvatar.ImageUrl" alt="" loading="lazy" />
                    }
                    else
                    {
                        <span>@Model.CurrentAvatar.Symbol</span>
                    }
                </div>
                <div>
                    <strong data-avatar-label>@(Model.CurrentAvatar?.Label ?? "Sem avatar selecionado")</strong>
                    <small>O avatar escolhido aparece no seu perfil.</small>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-app" asp-page-handler="SaveAvatar">Salvar avatar</button>
            </div>
        </form>
    </article>

    <article class="panel">
        <div class="panel-heading">
            <h2>Foto de perfil</h2>
            <span>upload ou camera, com recorte automatico</span>
        </div>

        <form method="post" enctype="multipart/form-data" class="stacked-form avatar-upload-form" asp-page-handler="UploadPhoto">
            <label>
                Escolher imagem
                <input type="file" name="AvatarPhoto" accept="image/*" capture="environment" data-avatar-photo-input />
            </label>

            <div class="profile-avatar-summary">
                <div class="profile-avatar-preview small" data-photo-preview>
                    @if (!string.IsNullOrWhiteSpace(Model.Participant?.AvatarImagePath))
                    {
                        <img src="@Model.Participant!.AvatarImagePath" alt="" loading="lazy" />
                    }
                    else
                    {
                        <span>👤</span>
                    }
                </div>
                <div>
                    <strong data-photo-label>@(string.IsNullOrWhiteSpace(Model.Participant?.AvatarImagePath) ? "Sem foto enviada" : "Foto atual")</strong>
                    <small>A imagem e cortada em formato quadrado e reduzida para tamanho padrao. A foto tem prioridade sobre o avatar escolhido.</small>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-app">Enviar foto</button>
            </div>
        </form>

        @if (!string.IsNullOrWhiteSpace(Model.Participant?.AvatarImagePath))
        {
            <form method="post" asp-page-handler="ClearPhoto" class="form-actions">
                <button type="submit" class="btn-app secondary">Remover foto</button>
            </form>
        }
    </article>
</section>

@section Scripts {
    <script>
        (() => {
            const form = document.querySelector('.avatar-picker-form');
            const preview = form?.querySelector('[data-avatar-preview]');
            const label = form?.querySelector('[data-avatar-label]');
            const photoInput = document.querySelector('[data-avatar-photo-input]');
            const photoPreview = document.querySelector('[data-photo-preview]');
            const photoLabel = document.querySelector('[data-photo-label]');

            if (!form || !preview || !label) {
                return;
            }

            const renderPreview = choice => {
                const option = choice.closest('.avatar-option');
                const visual = option?.querySelector('.avatar-option-visual');
                const optionLabel = option?.querySelector('.avatar-option-label');

                if (!visual || !optionLabel) {
                    return;
                }

                preview.innerHTML = visual.innerHTML;
                label.textContent = optionLabel.textContent ?? 'Sem avatar selecionado';
            };

            form.querySelectorAll('[data-avatar-choice]').forEach(choice => {
                choice.addEventListener('change', () => renderPreview(choice));

                if (choice.checked) {
                    renderPreview(choice);
                }
            });

            if (photoInput instanceof HTMLInputElement && photoPreview && photoLabel) {
                photoInput.addEventListener('change', () => {
                    const file = photoInput.files?.[0];
                    if (!file) {
                        return;
                    }

                    const imageUrl = URL.createObjectURL(file);
                    photoPreview.innerHTML = `<img src="${imageUrl}" alt="" loading="lazy" />`;
                    photoLabel.textContent = file.name;
                });
            }
        })();
    </script>
}
