@page
@model BolaoCopa2026.Pages.Conta.PerfilModel
@{
    ViewData["Title"] = "Perfil";
}

<section class="page-title">
    <p class="eyebrow">Conta</p>
    <h1>Perfil do Participante</h1>
</section>

<section class="profile-layout">
    <article class="panel">
        <h2>Acesso</h2>
        <form class="stacked-form">
            <label>
                Nome
                <input type="text" value="@Model.Participant?.Name" readonly />
            </label>
            <label>
                Email
                <input type="email" value="@Model.Participant?.Email" readonly />
            </label>
            <label>
                Login
                <input type="text" value="@Model.Participant?.Login" readonly />
            </label>
            <label>
                ID no banco
                <input type="text" value="@Model.Participant?.Id" readonly />
            </label>
        </form>
    </article>

    <article class="panel muted-panel">
        <h2>Comprovantes</h2>
        <p>Quando uma rodada for finalizada, o comprovante em imagem fica disponivel na tela de palpites com os metadados do seu cadastro.</p>
    </article>
</section>
