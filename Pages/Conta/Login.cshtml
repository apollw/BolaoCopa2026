@page
@model BolaoCopa2026.Pages.Conta.LoginModel
@{
    ViewData["Title"] = "Login";
}

<section class="page-title">
    <p class="eyebrow">Conta</p>
    <h1>Entrar</h1>
</section>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="notice">@Model.StatusMessage</div>
}

<section class="profile-layout">
    <article class="panel">
        <h2>Acesso por email</h2>
        <form method="post" class="stacked-form">
            <label asp-for="Input.Email">
                Email
                <input asp-for="Input.Email" autocomplete="email" />
                <span asp-validation-for="Input.Email"></span>
            </label>
            <label asp-for="Input.Password">
                Senha
                <input asp-for="Input.Password" autocomplete="current-password" />
                <span asp-validation-for="Input.Password"></span>
            </label>
            <button class="btn-app" type="submit">Entrar</button>
        </form>
    </article>

    <article class="panel muted-panel">
        <h2>Novo por aqui?</h2>
        <p>Crie seu cadastro com email e senha para salvar palpites no seu perfil e baixar seus comprovantes por rodada.</p>
        <a asp-page="/Conta/Cadastro" class="btn-app link-button">Criar cadastro</a>
    </article>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
